# NineGuard Configuration
NINEGUARD_PORT=8080
NINEGUARD_AUTH_ENABLED=true
NINEGUARD_DB_FILE=./data/nineguard.db

# 9router secrets (used by docker-compose.yml). Generate with: openssl rand -hex 32
NINEROUTER_INITIAL_PASSWORD=
NINEROUTER_JWT_SECRET=
NINEROUTER_API_KEY_SECRET=
NINEROUTER_MACHINE_ID_SALT=
